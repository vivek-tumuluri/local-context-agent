ENV=local

# Local defaults (overridden in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/local_context
REDIS_URL=redis://localhost:6379/0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

OPENAI_API_KEY=

SESSION_SECRET=replace-with-random-32chars
DRIVE_CREDENTIALS_KEY=replace-with-fernet-key

# Optional tuning
ANSWER_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Ingest / RAG quotas
MAX_INGESTS_PER_USER_PER_DAY=3
MAX_RAG_REQUESTS_PER_DAY=200

# Cookies / sessions
SESSION_COOKIE_NAME=lc_session
CSRF_COOKIE_NAME=lc_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_DAYS=30
# SESSION_COOKIE_SECURE=0
# SESSION_COOKIE_SAMESITE=lax

# Feature flags
READ_ONLY_MODE=0
ALLOW_INLINE_INGEST=1

# Ingest guardrails
# Comma-separated MIME allowlist (leave empty to use defaults)
# DRIVE_INGEST_ALLOWED_MIME=
AZERYN_MAX_FILE_BYTES=5000000
AZERYN_FALLBACK_MAX_BYTES=500000
AZERYN_MAX_CHUNKS_PER_FILE=300
AZERYN_AVG_TOKENS_PER_CHUNK=350
AZERYN_MAX_TOKENS_PER_FILE=0
AZERYN_MAX_TOKENS_PER_JOB=5000000
