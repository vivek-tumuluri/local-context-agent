ENV=production

# Required secrets (set to strong values)
DATABASE_URL=postgresql://postgres:postgres@db:5432/local_context
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-with-strong-random-32chars
DRIVE_CREDENTIALS_KEY=replace-with-fernet-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback
OPENAI_API_KEY=

# Feature flags / safety
READ_ONLY_MODE=0
ALLOW_INLINE_INGEST=0

# Cookies / sessions
SESSION_COOKIE_NAME=lc_session
CSRF_COOKIE_NAME=lc_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=strict

# Ingest / RAG quotas
MAX_INGESTS_PER_USER_PER_DAY=3
MAX_RAG_REQUESTS_PER_DAY=200

# Models
ANSWER_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
